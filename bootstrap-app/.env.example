# Copy to .env for local development.

# PostgreSQL connection string. Required by the Prisma CLI and at runtime.
# `npx sst dev` injects DATABASE_URL; keep this for `next dev` and Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bootstrap

# Public base URL of the app. Used by the OpenAPI document as its server URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# `sst dev` uses local Postgres by default. Set to true to use the shared
# Aurora/RDS over the SST tunnel instead.
# USE_REMOTE_DB=true

# AWS region for SST providers (default: eu-central-1)
# AWS_REGION=eu-central-1

# Root domain for DNS (falls back to SSM: /bootstrap/<stage>/config/ROOT_DOMAIN)
# ROOT_DOMAIN=

# Review stages: read shared SSM parameters from this stage instead
# ROOT_STAGE=
