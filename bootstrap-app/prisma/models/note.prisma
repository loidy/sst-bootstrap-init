// The one example model. It carries the conventions the rest of a real schema
// should follow rather than any interesting domain: a cuid primary key, a unique
// human-facing title, created/updated stamps, and `archivedAt` as a soft delete
// (rows are never hard-deleted, so an id in an audit trail or an old URL still
// resolves).
model Note {
  id         String     @id @default(cuid(2))
  title      String     @unique
  body       String
  status     NoteStatus @default(DRAFT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  archivedAt DateTime?

  @@index([createdAt])
  @@index([archivedAt])
}
